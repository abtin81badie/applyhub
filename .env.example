# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# The anon (public) key is safe to expose in the browser: all authorization is enforced by RLS.
# Never put the service_role key in any VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Base path the app is served from. "/" for a GitHub user site (https://<user>.github.io/),
# "/<repo>/" for a project site. The GitHub Actions workflow sets this automatically.
VITE_BASE_PATH=/
